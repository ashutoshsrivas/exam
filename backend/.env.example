# Copy to .env and fill in. Never commit .env itself.
PORT=4000
NODE_ENV=production

# Comma-separated list of allowed browser origins. In production this must be
# your real domain — a wildcard here would let any site call the API with a
# logged-in user's token.
CORS_ORIGIN=https://exam-slot.geu.ac.in

# Set when the API runs behind nginx or a load balancer, so req.ip (used by the
# login rate limiter) is the real client rather than the proxy.
TRUST_PROXY=1

DB_HOST=localhost
DB_PORT=3306
# Use a dedicated MySQL account limited to this database — not root.
DB_USER=exam_app
DB_PASSWORD=
DB_NAME=exam

# REQUIRED. The server refuses to start without a real one unless
# NODE_ENV=development. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
